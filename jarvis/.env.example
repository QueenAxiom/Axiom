# Copy this file to .env and fill in your keys. Never commit .env.

# Claude API key from console.anthropic.com (billed per use, separate from the Max plan)
ANTHROPIC_API_KEY=

# Optional: ElevenLabs for Sophia's real voice. Leave blank to use the browser's built-in voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
PORT=3000
